{% extends "layouts/base.njk" %}

{% block title %}Home — {{ siteName }}{% endblock %}

{% block main_class %}home{% endblock %}

{% block content %}

{#section banner#}
  {% from "macros/section-banner.njk" import render_section_banner as section_banner with context %}
  {{section_banner(
    img_url="images/img/banner-img-home.png",
    img_mob_url="images/img/banner-mob.png",
    title="<strong>Bioscience GROUP</strong> - ми допоможемо твоєму бізнесу розширитись"
  ) }}

  <section class="section-work" data-parallax-bg data-parallax-speed="-0.25">
    <div class="container" >
      <img class="parallax-img" src="images/img/logo-bg.svg" alt="" aria-hidden="true">
      <div class="split-layout">
        <div class="split-layout__col3">
          <div class="section__header">
            <div class="title-wrapper">
              <h2 class="section__title-gb">Що ми робимо</h2>
            </div>
          </div>
        </div>
        <div class="split-layout__col5">
          <div class="section__content text_lg">
            <p>Ми пропонуємо комплексні рішення у сфері виробництва та просування фармацевтичної
              продукції.
              Поєднуючи експертизу у виробничих процесах із глибоким розумінням ринку, ми допомагаємо
              партнерам
              створювати конкурентоспроможні продукти та ефективно виводити їх на ринок.</p>
            <p>Наш підхід ґрунтується на якості, надійності та інноваціях, що дозволяє нам розробляти
              результативні
              рішення та формувати довгострокові партнерські відносини у фармацевтичній галузі</p>

          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="sticky-trigger" data-story-trigger>

    <section class="story-section" data-story>
      <div class="story-pin-wrap container">

        <div class="story-top">
          <div class="story-progress">
            <div class="story-progress__bar"></div>
          </div>
          <div class="story-meta">
            <div class="story-fraction">
              <span class="story-current">01</span>
              <span>/</span>
              <span class="story-total">02</span>
            </div>
          </div>
        </div>

        <div class="story-slides">
          <article class="story-slide">
            <h3 class="heading_xl" data-story-text>Місія</h3>
            <p class="text_xl" data-story-text>Створювати якісні та безпечні продукти за доступною
              ціною, забезпечувати інноваційні рішення у сфері здоров’я, повертаючи людям радість
              повноцінного життя.</p>
          </article>

          <article class="story-slide">
            <h3 class="heading_xl" data-story-text>Цінності</h3>
            <p class="text_xl" data-story-text>Наш підхід ґрунтується на якості, надійності та
              інноваціях, що дозволяє нам розробляти результативні рішення та формувати довгострокові
              партнерські відносини у фармацевтичній галузі.</p>
          </article>
        </div>
      </div>
    </section>
  </div>

