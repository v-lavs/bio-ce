  <section class="section section-contacts">
    <div class="container">
      <h2 class="heading_lg">Зв’яжіться з нами, якщо вам потрібна допомога</h2>
      <ul class="contacts-list">
        <li class="contacts-list__item phone">
          <h3 class="contacts-list__title">Основний телефон:</h3>
          <a href="tel:+380432523049">+38 043 252 30 49</a>
        </li>
        <li class="contacts-list__item email">
          <h3 class="contacts-list__title">Пошта:</h3>
          <a href="mailto:office@bsc-bioscience.co.uk">office@bsc-bioscience.co.uk</a>
        </li>
        <li class="contacts-list__item address">
          <h3 class="contacts-list__title">Адреса:</h3>
          <p>м. Київ, бульвар Вацлава Гавела, 40</p>
        </li>
      </ul>

      <form action="#" method="post" name="contact-form" class="form form_contact">
        <div class="inner-form-contact">
          <div class="tabs" data-tabs>
            <p><strong>Ви бажаєте</strong></p>
            <div class="tabs__nav" role="tablist">
              <button type="button" class="tabs-nav__link heading_md active" data-tab="partner"
                      role="tab" aria-selected="true">
                Стати партнером
              </button>
              <button type="button" class="tabs-nav__link heading_md" data-tab="joinTeam" role="tab"
                      aria-selected="false">
                Приєднатись до команди
              </button>
              <div class="tab-active-border"></div>
            </div>
            <div class="tabs__content-box d-flex">
              <div class="tabs__content">
                <div id="partner" class="tab-content active" role="tabpanel">
                  <div class="fieldboxes">
                    <div class="form-group">
                      <label class="label" for="lastNamePartner">Прізвище</label>
                      <input id="lastNamePartner" type="text" name="last-name">
                    </div>
                    <div class="form-group">
                      <label class="label" for="firstNamePartner">Ім'я</label>
                      <input id="firstNamePartner" type="text" name="first-name"
                             autocomplete="name">
                    </div>
                    <div class="form-group">
                      <label class="label" for="emailPartner">Email</label>
                      <input id="emailPartner" type="email" name="email" autocomplete="email">
                    </div>
                    <div class="form-group">
                      <label class="label" for="phoneNumberPartner">Номер телефону</label>
                      <input id="phoneNumberPartner" type="tel" name="phone-number">
                    </div>
                    <div class="form-group form-group_big">
                      <label class="label" for="descriptionPartner">Ваше повідомлення</label>
                      <textarea name="description" id="descriptionPartner" cols="30" rows="10"
                                placeholder="Ми радо відповімо на усі питання"></textarea>
                    </div>
                  </div>
                </div>
                <div id="joinTeam" class="tab-content" role="tabpanel">
                  <div class="fieldboxes">
                    <div class="form-group">
                      <label class="label" for="lastName">Прізвище</label>
                      <input id="lastName" type="text" name="last-name">
                    </div>
                    <div class="form-group">
                      <label class="label" for="firstName">Ім'я</label>
                      <input id="firstName" type="text" name="first-name" autocomplete="name">
                    </div>
                    <div class="form-group">
                      <label class="label" for="email">Email</label>
                      <input id="email" type="email" name="email" autocomplete="email">
                    </div>
                    <div class="form-group">
                      <label class="label" for="phoneNumber">Номер телефону</label>
                      <input id="phoneNumber" type="tel" name="phone-number">
                    </div>
                    <div class="form-group form-group_big">
                      <label class="label" for="descriptionContacts">Ваше повідомлення</label>
                      <textarea name="description" id="descriptionContacts" cols="30"
                                rows="10"
                                placeholder="Ми радо відповімо на усі питання"></textarea>
                    </div>
                  </div>
                </div>
              </div>
              <div class="logobox">
                <img class="form__logo" src="images/img/logo-for-form.svg" width="302" height="406"
                     alt="Лого Bioscience GROUP">
              </div>
            </div>
          </div>
        </div>
        <div class="form__footer">
          <button class="btn btn_submit" type="submit">
                            <span class="btn__inner">

    <span class="btn__text-block">
      <span class="btn__text">Надіслати</span>
      <svg class="text-bg" viewBox="0 0 220 49" preserveAspectRatio="none">
        <defs>
          <linearGradient id="text-grad-dynamic" x1="0" y1="0" x2="0" y2="1">
            <stop class="text-stop-top" offset="0%" stop-color="#056AFD" />
            <stop class="text-stop-bottom" offset="100%" stop-color="#89FBC1" />
          </linearGradient>
        </defs>

        <path class="text-path text-path-main"
              d="M10 0.5H209.129C215.328 0.500115 219.866 6.34183 218.334 12.3486L210.936 41.3486C209.862 45.5559 206.073 48.5 201.73 48.5H10C4.7533 48.5 0.5 44.2467 0.5 39V10C0.500001 4.7533 4.7533 0.5 10 0.5Z"
              fill="url(#text-grad-dynamic)" fill-opacity="0"
              stroke="url(#text-grad-dynamic)" stroke-width="1"
              vector-effect="non-scaling-stroke" />
      </svg>
    </span>

                              <!-- БЛОК ІКОНКИ -->
    <span class="btn__icon">
      <svg width="51" height="49" viewBox="0 0 51 49" fill="none">
          <path class="icon-path icon-path-main"
                d="M18.165 0.5H41C46.2467 0.5 50.5 4.7533 50.5 10V39C50.5 44.2467 46.2467 48.5 41 48.5H12.2471C6.23701 48.5 1.73687 42.9893 2.93848 37.1006L8.85742 8.10059C9.73194 3.81546 13.4107 0.699243 17.7441 0.508789L18.165 0.5Z"
                fill="url(#icon-grad-dynamic)" stroke="url(#icon-grad-dynamic)" stroke-width="1" />
          <path class="arrow-path"
                d="M26.72 19.9508C26.6463 19.8821 26.5872 19.7993 26.5462 19.7073C26.5052 19.6153 26.4832 19.516 26.4814 19.4153C26.4796 19.3146 26.4981 19.2146 26.5359 19.1212C26.5736 19.0278 26.6297 18.943 26.701 18.8718C26.7722 18.8006 26.857 18.7444 26.9504 18.7067C27.0438 18.669 27.1438 18.6504 27.2445 18.6522C27.3452 18.654 27.4445 18.676 27.5365 18.717C27.6285 18.758 27.7113 18.8171 27.78 18.8908L31.78 22.8908C31.9204 23.0314 31.9993 23.2221 31.9993 23.4208C31.9993 23.6196 31.9204 23.8102 31.78 23.9508L27.78 27.9508C27.7113 28.0245 27.72 28.0836 27.5365 28.1246C27.4445 28.1656 27.3452 28.1876 27.2445 28.1894C27.1438 28.1912 27.0438 28.1727 26.9504 28.1349C26.857 28.0972 26.7722 28.0411 26.701 27.9698C26.6297 27.8986 26.5736 27.8138 26.5359 27.7204C26.4981 27.627 26.4796 27.527 26.4814 27.4263C26.4832 27.3256 26.5052 27.2263 26.5462 27.1343C26.5872 27.0423 26.6463 26.9595 26.72 26.8908L29.44 24.1708H19.75C19.5511 24.1708 19.3603 24.0918 19.2197 23.9511C19.079 23.8105 19 23.6197 19 23.4208C19 23.2219 19.079 23.0311 19.2197 22.8905C19.3603 22.7498 19.5511 22.6708 19.75 22.6708H29.44L26.72 19.9508Z"
                fill="white" />
          <defs>
            <linearGradient id="icon-grad-dynamic" x1="25.5" y1="0" x2="25.5" y2="49" gradientUnits="userSpaceOnUse">
              <stop class="icon-stop-top" offset="0%" stop-color="#056AFD" />
              <stop class="icon-stop-bottom" offset="100%" stop-color="#89FBC1" />
            </linearGradient>
          </defs>
      </svg>
    </span>

  </span>
          </button>
        </div>
      </form>
    </div>
  </section>
{% endblock %}