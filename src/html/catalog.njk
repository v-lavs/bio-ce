{# src/html/catalog.njk #}

{% extends "layouts/base.njk" %}
{% block main_class %} page page-catalog {% endblock %}
{% block title %}Наші препарати — {{ siteName }}{% endblock %}
{% block content %}
    {% from "macros/section-banner.njk" import render_section_banner as section_banner with context %}
    {% from "macros/breadcrumbs.njk" import render_breadcrumbs as breadcrumbs with context %}
    {% from "macros/card.njk" import card with context %}
    {{ section_banner(
        img_url="images/img/banner-catalog.png",
        title="наші препарати"
    ) }}
    {{ breadcrumbs ([
        {title: "Наші препарати",  url: "#"},
        {title: "Гінекологія"}
    ]) }}
    <div class="container catalog__top-line">
        {% include "partials/search.njk" %}
        <button type="button" class="btn-open-sidebar"><img src="images/img/filter.svg" alt="" aria-hidden="true"></button>
    </div>
    <section class="section-catalog">
        <div class="backdrop"></div>
        <div class="container">
            {% set products_list = [
                {
                    title: "Клиндамицин",
                    text: "напівсинтетичний препарат з групи лінкозамідів для перорального, парентерального та місцевого застосування. Кліндаміцин застосовується у ...",
                    imgUrl: "images/img/preparat.png",
                    link: "single-product.html",
                    type: "default"
                },
                {
                    title: "Лінкоміцину гідрохлорид капсули",
                    text: "напівсинтетичний препарат з групи лінкозамідів для перорального, парентерального та місцевого застосування. Кліндаміцин застосовується у ...",
                    imgUrl: "images/img/preparat.png",
                    link: "single-product.html",
                    type: "default"
                },
                {
                    title: "Clindamycin",
                    text: "напівсинтетичний препарат з групи лінкозамідів для перорального, парентерального та місцевого застосування. Кліндаміцин застосовується у ...",
                    imgUrl: "images/img/preparat.png",
                    link: "single-product.html",
                    type: "default"
                },
                {
                    title: "Clindamycin",
                    text: "напівсинтетичний препарат з групи лінкозамідів для перорального, парентерального та місцевого застосування. Кліндаміцин застосовується у ...",
                    imgUrl: "images/img/preparat.png",
                    link: "single-product.html",
                    type: "default"
                },
                {
                    title: "Clindamycin",
                    text: "напівсинтетичний препарат з групи лінкозамідів для перорального, парентерального та місцевого застосування. Кліндаміцин застосовується у ...",
                    imgUrl: "images/img/preparat.png",
                    link: "single-product.html",
                    type: "default"
                },
                {
                    title: "Clindamycin",
                    text: "напівсинтетичний препарат з групи лінкозамідів для перорального, парентерального та місцевого застосування. Кліндаміцин застосовується у ...",
                    imgUrl: "images/img/preparat.png",
                    link: "single-product.html",
                    type: "default"
                }
            ] %}
            <div class="section-catalog__inner">
                <div class="sidebar category-filter">
                    <h3 class="category-filter__title">Категорії</h3>
                    <div class="splide slider-category" aria-label="Фільтр категорій">
                        {# slider navigation #}
                        <div class="splide__arrows custom-arrows">
                            <button class="splide__arrow splide__arrow--prev" type="button" aria-label="Назад">
                                <svg width="51" height="46" viewBox="0 0 51 46" fill="none"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <path d="M18.0596 0.5H41C46.2467 0.5 50.5 4.7533 50.5 10V36C50.5 41.2467 46.2467 45.5 41 45.5H12.4072C6.34769 45.4998 1.83679 39.9027 3.12402 33.9814L8.77637 7.98145C9.72587 3.61465 13.5907 0.500039 18.0596 0.5Z"
                                          stroke="url(#paint0_linear_572_10246)" />
                                    <path d="M26.72 19.2987C26.6464 19.23 26.5873 19.1472 26.5463 19.0552C26.5053 18.9632 26.4832 18.8639 26.4815 18.7632C26.4797 18.6625 26.4982 18.5625 26.5359 18.4691C26.5736 18.3757 26.6298 18.2909 26.701 18.2197C26.7722 18.1485 26.8571 18.0923 26.9505 18.0546C27.0438 18.0169 27.1439 17.9983 27.2446 18.0001C27.3453 18.0019 27.4446 18.0239 27.5366 18.0649C27.6286 18.1059 27.7114 18.165 27.78 18.2387L31.78 22.2387C31.9205 22.3793 31.9994 22.57 31.9994 22.7687C31.9994 22.9675 31.9205 23.1581 31.78 23.2987L27.78 27.2987C27.7114 27.3724 27.6286 27.4315 27.5366 27.4725C27.4446 27.5135 27.3453 27.5355 27.2446 27.5373C27.1439 27.5391 27.0438 27.5206 26.9505 27.4828C26.8571 27.4451 26.7722 27.389 26.701 27.3177C26.6298 27.2465 26.5736 27.1617 26.5359 27.0683C26.4982 26.9749 26.4797 26.8749 26.4815 26.7742C26.4832 26.6735 26.5053 26.5742 26.5463 26.4822C26.5873 26.3902 26.6464 26.3074 26.72 26.2387L29.44 23.5187H19.75C19.5511 23.5187 19.3604 23.4397 19.2197 23.299C19.0791 23.1584 19 22.9676 19 22.7687C19 22.5698 19.0791 22.379 19.2197 22.2384C19.3604 22.0977 19.5511 22.0187 19.75 22.0187H29.44L26.72 19.2987Z"
                                          fill="currentColor" />
                                    <defs>
                                        <linearGradient id="paint0_linear_572_10246" x1="25.5" y1="0" x2="25.5" y2="46"
                                                        gradientUnits="userSpaceOnUse">
                                            <stop stop-color="#056AFD" />
                                            <stop offset="1" stop-color="#89FBC1" />
                                        </linearGradient>
                                    </defs>
                                </svg>
                            </button>
                            <button class="splide__arrow splide__arrow--next" type="button" aria-label="Вперед">
                                <svg width="51" height="46" viewBox="0 0 51 46" fill="none"
                                     xmlns="http://www.w3.org/2000/svg">
                                    <path d="M32.9404 0.5H10C4.7533 0.5 0.5 4.7533 0.5 10V36C0.5 41.2467 4.7533 45.5 10 45.5H38.5928C44.6523 45.4998 49.1632 39.9027 47.876 33.9814L42.2236 7.98145C41.2741 3.61465 37.4093 0.500039 32.9404 0.5Z"
                                          stroke="url(#paint0_linear_572_10250)" />
                                    <path d="M21.2792 19.2987C21.3529 19.23 21.412 19.1472 21.453 19.0552C21.494 18.9632 21.516 18.8639 21.5178 18.7632C21.5196 18.6625 21.5011 18.5625 21.4633 18.4691C21.4256 18.3757 21.3695 18.2909 21.2983 18.2197C21.227 18.1485 21.1422 18.0923 21.0488 18.0546C20.9554 18.0169 20.8554 17.9983 20.7547 18.0001C20.654 18.0019 20.5547 18.0239 20.4627 18.0649C20.3707 18.1059 20.2879 18.165 20.2192 18.2387L16.2192 22.2387C16.0788 22.3793 15.9999 22.57 15.9999 22.7687C15.9999 22.9675 16.0788 23.1581 16.2192 23.2987L20.2192 27.2987C20.2879 27.3724 20.3707 27.4315 20.4627 27.4725C20.5547 27.5135 20.654 27.5355 20.7547 27.5373C20.8554 27.5391 20.9554 27.5206 21.0488 27.4828C21.1422 27.4451 21.227 27.389 21.2983 27.3177C21.3695 27.2465 21.4256 27.1617 21.4633 27.0683C21.5011 26.9749 21.5196 26.8749 21.5178 26.7742C21.516 26.6735 21.494 26.5742 21.453 26.4822C21.412 26.3902 21.3529 26.3074 21.2792 26.2387L18.5592 23.5187H28.2492C28.4481 23.5187 28.6389 23.4397 28.7795 23.299C28.9202 23.1584 28.9992 22.9676 28.9992 22.7687C28.9992 22.5698 28.9202 22.379 28.7795 22.2384C28.6389 22.0977 28.4481 22.0187 28.2492 22.0187H18.5592L21.2792 19.2987Z"
                                          fill="currentColor" />
                                    <defs>
                                        <linearGradient id="paint0_linear_572_10250" x1="25.5" y1="0" x2="25.5" y2="46"
                                                        gradientUnits="userSpaceOnUse">
                                            <stop stop-color="#056AFD" />
                                            <stop offset="1" stop-color="#89FBC1" />
                                        </linearGradient>
                                    </defs>
                                </svg>
                            </button>
                        </div>
                        <div class="splide__track">
                            <ul class="splide__list">
                                <li class="splide__slide is-selected-category">
                                    <a href="#">Всі категорії</a>
                                </li>
                                {% set categories = [
                                    { name: "Когнітивне здоров'я", url: "#", active: true },
                                    { name: "Психіатрія", url: "#" },
                                    { name: "Гастроентерологія", url: "#" },
                                    { name: "Дерматологія", url: "#" },
                                    { name: "Неврологія", url: "#" },
                                    { name: "Офтальмологія", url: "#" },
                                    { name: "Ревматологія", url: "#" },
                                    { name: "Алергологія", url: "#" },
                                    { name: "Анестизіологія", url: "#" },
                                    { name: "Кардіологія", url: "#" }
                                ] %}
                                {% for item in categories %}
                                    <li class="splide__slide">
                                        <a href="{{ item.url }}">{{ item.name }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="catalog-wrap">
                <div class="catalog-grid">
                    {% for item in products_list %}
                        {{ card(
                            imgUrl = item.imgUrl,
                            title = item.title,
                            text = item.text,
                            link = item.link,
                            type = item.type
                        ) }}
                    {% endfor %}
                </div>
                    {% include "partials/pagination.njk" %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}